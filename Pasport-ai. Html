
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>AI Passport Studio</title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css" />
  <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; font-family: system-ui, -apple-system, sans-serif; }
    body { background: #090d16; color: #f8fafc; padding-bottom: 30px; }

    .topbar {
      background: #131b2e; padding: 14px 16px; display: flex; align-items: center; gap: 12px;
      border-bottom: 1px solid #1e293b; position: sticky; top: 0; z-index: 50;
    }
    .back-btn {
      background: #1e293b; color: #fff; border: none; padding: 8px 14px; border-radius: 10px;
      font-weight: 700; cursor: pointer;
    }
    .topbar h1 { font-size: 1.05rem; font-weight: 800; }

    .container { max-width: 520px; margin: 0 auto; padding: 14px; }
    .card {
      background: #131b2e; border: 1px solid #1e293b; border-radius: 18px; padding: 16px; margin-bottom: 14px;
    }
    .step-badge {
      background: linear-gradient(90deg, #2563eb, #7c3aed); color: #fff; font-size: 0.72rem;
      font-weight: 800; padding: 4px 10px; border-radius: 20px; display: inline-block; margin-bottom: 8px;
    }
    h2 { font-size: 1.05rem; margin-bottom: 6px; }
    p.sub { font-size: 0.8rem; color: #94a3b8; margin-bottom: 12px; }

    .upload-box {
      border: 2px dashed #3b82f6; border-radius: 14px; padding: 24px 14px; text-align: center;
      background: rgba(37, 99, 235, 0.08); cursor: pointer;
    }
    .btn {
      width: 100%; padding: 13px; border: none; border-radius: 12px; font-weight: 800;
      font-size: 0.92rem; cursor: pointer; color: #fff; background: linear-gradient(135deg, #2563eb, #4f46e5);
      margin-top: 8px;
    }
    .btn-green { background: linear-gradient(135deg, #059669, #10b981); }
    .btn:disabled { opacity: 0.5; cursor: not-allowed; }

    /* Cropper Area */
    .crop-container { width: 100%; max-height: 340px; overflow: hidden; border-radius: 12px; background: #000; margin-bottom: 10px; }
    .crop-container img { max-width: 100%; display: block; }

    /* Color Swatches */
    .colors { display: flex; gap: 10px; margin: 10px 0 14px; }
    .swatch {
      width: 38px; height: 38px; border-radius: 50%; border: 3px solid #334155; cursor: pointer;
    }
    .swatch.active { border-color: #3b82f6; transform: scale(1.1); }

    .row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 10px; }
    select {
      width: 100%; padding: 10px; border-radius: 10px; background: #090d16; color: #fff;
      border: 1px solid #334155; font-size: 0.88rem;
    }

    /* Full Preview */
    .preview-wrap {
      background: #fff; padding: 8px; border-radius: 12px; text-align: center; margin-top: 10px;
    }
    .preview-wrap img { width: 100%; border-radius: 6px; box-shadow: 0 4px 14px rgba(0,0,0,0.2); }

    .loader {
      display: none; text-align: center; padding: 14px; background: rgba(59,130,246,0.12);
      border-radius: 12px; margin-top: 10px; font-size: 0.85rem; color: #60a5fa; font-weight: 700;
    }
  </style>
</head>
<body>

<div class="topbar">
  <button class="back-btn" onclick="location.href='index.html'">← Home</button>
  <h1>AI Passport Photo Studio</h1>
</div>

<div class="container">

  <!-- STEP 1: UPLOAD -->
  <div class="card">
    <span class="step-badge">STEP 1 • SELECT SELFIE</span>
    <h2>Upload Any Photo</h2>
    <p class="sub">Normal selfie ya camera photo chunein, AI khud background hatayega</p>
    <div class="upload-box" onclick="document.getElementById('fileIn').click()">
      <div style="font-size:1.8rem; margin-bottom:6px;">📸</div>
      <strong>Tap to Choose Photo from Gallery</strong>
      <input type="file" id="fileIn" accept="image/*" style="display:none" onchange="handleUpload(event)" />
    </div>
  </div>

  <!-- STEP 2: CROP & AI BG REMOVE -->
  <div class="card" id="step2Card" style="display:none;">
    <span class="step-badge">STEP 2 • CROP & AI BACKGROUND</span>
    <h2>Set Face & Background Color</h2>
    <div class="crop-container">
      <img id="cropImg" />
    </div>

    <label style="font-size:0.8rem; color:#94a3b8; font-weight:700;">Choose Passport Background:</label>
    <div class="colors">
      <div class="swatch active" style="background:#ffffff;" onclick="pickBg('#ffffff', this)"></div>
      <div class="swatch" style="background:#38bdf8;" onclick="pickBg('#38bdf8', this)"></div>
      <div class="swatch" style="background:#1d4ed8;" onclick="pickBg('#1d4ed8', this)"></div>
      <div class="swatch" style="background:#e2e8f0;" onclick="pickBg('#e2e8f0', this)"></div>
      <div class="swatch" style="background:#f43f5e;" onclick="pickBg('#f43f5e', this)"></div>
    </div>

    <button class="btn" id="aiBtn" onclick="runAiPassport()">✨ Remove Background & Make Passport</button>
    <div class="loader" id="aiLoader">⏳ AI Background Remove kar raha hai (Pehli baar 10-15 sec lag sakte hain)...</div>
  </div>

  <!-- STEP 3: FULL SCREEN A4 SHEET -->
  <div class="card" id="step3Card" style="display:none;">
    <span class="step-badge">STEP 3 • PRINT-READY A4 SHEET</span>
    <h2>Full A4 Sheet Preview</h2>
    <div class="row" style="margin-top:10px;">
      <div>
        <label style="font-size:0.75rem; color:#94a3b8;">Copies on A4:</label>
        <select id="copyCount" onchange="renderA4Sheet()">
          <option value="8">8 Photos (2 Rows)</option>
          <option value="12" selected>12 Photos (3 Rows)</option>
          <option value="24">24 Photos (6 Rows)</option>
        </select>
      </div>
      <div>
        <label style="font-size:0.75rem; color:#94a3b8;">Cutting Border:</label>
        <select id="borderOpt" onchange="renderA4Sheet()">
          <option value="yes">Black Border</option>
          <option value="no">No Border</option>
        </select>
      </div>
    </div>

    <div class="preview-wrap">
      <img id="finalSheetImg" />
    </div>

    <button class="btn btn-green" onclick="downloadA4Pdf()">⬇️ Download Print-Ready PDF</button>
    <button class="btn" style="background:#1e293b;" onclick="downloadSinglePhoto()">⬇️ Download Single Passport JPG</button>
  </div>

</div>

<script type="module">
  import { removeBackground } from "https://cdn.jsdelivr.net/npm/@imgly/background-removal@1.4.5/+esm";

  let cropper = null;
  let selectedBg = "#ffffff";
  let singlePassportUrl = "";
  let finalSheetUrl = "";

  window.handleUpload = function(e) {
    const file = e.target.files[0];
    if (!file) return;
    const url = URL.createObjectURL(file);
    const img = document.getElementById("cropImg");
    img.src = url;
    document.getElementById("step2Card").style.display = "block";
    document.getElementById("step3Card").style.display = "none";

    if (cropper) cropper.destroy();
    cropper = new Cropper(img, {
      aspectRatio: 3.5 / 4.5,
      viewMode: 1,
      autoCropArea: 0.85
    });
    document.getElementById("step2Card").scrollIntoView({ behavior: "smooth" });
  };

  window.pickBg = function(color, el) {
    selectedBg = color;
    document.querySelectorAll(".swatch").forEach(s => s.classList.remove("active"));
    el.classList.add("active");
    if (singlePassportUrl) renderA4Sheet();
  };

  let transparentPersonImg = null;

  window.runAiPassport = async function() {
    if (!cropper) return;
    const btn = document.getElementById("aiBtn");
    const loader = document.getElementById("aiLoader");
    btn.disabled = true;
    loader.style.display = "block";

    try {
      const croppedCanvas = cropper.getCroppedCanvas({ width: 500, height: 643 });
      const blob = await new Promise(res => croppedCanvas.toBlob(res, "image/png"));
      
      // Client-side AI Background Removal
      const resultBlob = await removeBackground(blob);
      const resultUrl = URL.createObjectURL(resultBlob);

      transparentPersonImg = new Image();
      transparentPersonImg.onload = () => {
        document.getElementById("step3Card").style.display = "block";
        renderA4Sheet();
        document.getElementById("step3Card").scrollIntoView({ behavior: "smooth" });
      };
      transparentPersonImg.src = resultUrl;
    } catch (err) {
      alert("AI processing mein issue aaya, direct cropped photo use kar rahe hain.");
      transparentPersonImg = new Image();
      transparentPersonImg.onload = () => {
        document.getElementById("step3Card").style.display = "block";
        renderA4Sheet();
      };
      transparentPersonImg.src = cropper.getCroppedCanvas({ width: 500, height: 643 }).toDataURL("image/png");
    } finally {
      btn.disabled = false;
      loader.style.display = "none";
    }
  };

  window.renderA4Sheet = function() {
    if (!transparentPersonImg) return;

    // 1. Create single passport with solid background
    const singleC = document.createElement("canvas");
    singleC.width = 413; singleC.height = 531; // 3.5x4.5cm at 300 DPI
    const sCtx = singleC.getContext("2d");
    sCtx.fillStyle = selectedBg;
    sCtx.fillRect(0, 0, singleC.width, singleC.height);
    sCtx.drawImage(transparentPersonImg, 0, 0, singleC.width, singleC.height);
    singlePassportUrl = singleC.toDataURL("image/jpeg", 0.95);

    // 2. Create A4 Print Sheet
    const a4 = document.createElement("canvas");
    a4.width = 1240; a4.height = 1754;
    const ctx = a4.getContext("2d");
    ctx.fillStyle = "#ffffff";
    ctx.fillRect(0, 0, a4.width, a4.height);

    const copies = parseInt(document.getElementById("copyCount").value);
    const hasBorder = document.getElementById("borderOpt").value === "yes";
    const cols = 4;
    const rows = copies / 4;
    const pw = 245, ph = 315, gap = 42;
    const startX = (a4.width - (cols * pw + (cols - 1) * gap)) / 2;
    const startY = 75;

    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        const x = startX + c * (pw + gap);
        const y = startY + r * (ph + gap);
        ctx.drawImage(singleC, x, y, pw, ph);
        if (hasBorder) {
          ctx.strokeStyle = "#000000";
          ctx.lineWidth = 3;
          ctx.strokeRect(x, y, pw, ph);
        }
      }
    }

    finalSheetUrl = a4.toDataURL("image/jpeg", 0.94);
    document.getElementById("finalSheetImg").src = finalSheetUrl;
  };

  window.downloadA4Pdf = function() {
    const { jsPDF } = window.jspdf;
    const pdf = new jsPDF("p", "mm", "a4");
    pdf.addImage(finalSheetUrl, "JPEG", 0, 0, 210, 297);
    pdf.save("AI_Passport_Sheet_A4.pdf");
  };

  window.downloadSinglePhoto = function() {
    const a = document.createElement("a");
    a.href = singlePassportUrl;
    a.download = "Passport_Photo.jpg";
    a.click();
  };
</script>
</body>
</html>
